# Environment Configuration for FaraTech
# Copy this file to .env and update the values for your environment

# Database Configuration
DB_HOST=localhost
DB_NAME=FaraTech
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Site Configuration
SITE_URL=https://faratechlab.ir
SITE_NAME=FaraTech
SITE_EMAIL=faratechteam@gmail.com

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Security
APP_ENV=production
SESSION_TIMEOUT=1800
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/

# Social Media
INSTAGRAM_URL=https://www.instagram.com/faratech.lab
LINKEDIN_URL=https://www.linkedin.com/company/faratechlab
